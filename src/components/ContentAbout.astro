---
import { Prism } from "@astrojs/prism";

const code = `interface Developer {
    name: string;
    skills: string[];
    interests: string[];
};

interface TechStack {
    languages: string[];
    frontend: string[];
    devOps: string[];
    backend: string[];
    database: string[];
    testing: string[];
};

type ContactType = 'github' | 'linkedIn' | 'email';

const techStack: TechStack = {
    languages: [
        'JavaScript',
        'TypeScript',
        'Ruby',
        'Python',
    ],
    frontend: [
        'React',
        'TailwindCSS',
        'Astro',
        'SCSS',
        'Markdown',
        'WordPress',
    ],
    devOps: [
        'GitLab',
        'GitHub',
        'Docker',
    ],
    backend: [
        'Node.js',
        'Bun',
        'Deno',
        'Ruby on Rails',
        'Supabase',
        'Django',
    ],
    database: [
        'PostgreSQL',
        'MySQL',
        'SQLite',
    ],
    testing: [
        'Jest',
        'Vitest',
    ],
};

// Developer profile
const me: Developer = {
    name: 'Paul Kaizirege',
    skills: [
        ...techStack.languages,
        ...techStack.frontend,
        ...techStack.devOps,
        ...techStack.backend,
        ...techStack.database,
        ...techStack.testing,
    ],
    interests: [
        'Security',
        'Privacy',
        'Performance',
        'Self-Hosting',
        'Networking',
    ]
};

// Contact function
const contact = (type: ContactType): string => {
    switch (type) {
        case 'github':
            return 'https://github.com/kaizipaul';
        case 'twitter':
            return 'https://x.com/mykved';
        case 'linkedIn':
            return 'https://www.linkedin.com/in/kaizipaul';
        case 'email':
            return 'paulkaizirege@gmail.com';
        default:
            return 'Send fax.';
    }
};
`;
---

<Prism lang="typescript" code={code} />

<style is:global>
    pre[class*="language-"] {
        background: transparent !important;
        margin: 0;
        padding: 0;
        overflow-x: auto;
        white-space: pre-wrap;
        word-wrap: break-word;
        font-family: "Jetbrains Mono", monospace;
        font-size: 0.85rem;
    }

    code[class*="language-"] {
        font-family: "Jetbrains Mono", monospace;
        font-size: 0.85rem;
        display: block;
        counter-reset: step;
        counter-increment: step 0;
    }

    /* ── Light mode (github-light colors) ── */
    code[class*="language-"] .token.keyword,
    code[class*="language-"] .token.operator {
        color: #d73a49;
    }
    code[class*="language-"] .token.string,
    code[class*="language-"] .token.attr-value {
        color: #032f62;
    }
    code[class*="language-"] .token.class-name,
    code[class*="language-"] .token.builtin {
        color: #6f42c1;
    }
    code[class*="language-"] .token.number,
    code[class*="language-"] .token.boolean {
        color: #005cc5;
    }
    code[class*="language-"] .token.comment {
        color: #6a737d;
        font-style: italic;
    }
    code[class*="language-"] .token.function {
        color: #6f42c1;
    }
    code[class*="language-"] .token.punctuation {
        color: #24292e;
    }
    code[class*="language-"] .token.parameter,
    code[class*="language-"] .token.property-access {
        color: #e36209;
    }

    /* ── Dark mode (github-dark colors) ── */
    html.dark code[class*="language-"] .token.keyword,
    html.dark code[class*="language-"] .token.operator {
        color: #f97583;
    }
    html.dark code[class*="language-"] .token.string,
    html.dark code[class*="language-"] .token.attr-value {
        color: #9ecbff;
    }
    html.dark code[class*="language-"] .token.class-name,
    html.dark code[class*="language-"] .token.builtin {
        color: #b392f0;
    }
    html.dark code[class*="language-"] .token.number,
    html.dark code[class*="language-"] .token.boolean {
        color: #79b8ff;
    }
    html.dark code[class*="language-"] .token.comment {
        color: #6a737d;
        font-style: italic;
    }
    html.dark code[class*="language-"] .token.function {
        color: #b392f0;
    }
    html.dark code[class*="language-"] .token.punctuation {
        color: #e1e4e8;
    }
    html.dark code[class*="language-"] .token.parameter,
    html.dark code[class*="language-"] .token.property-access {
        color: #ffab70;
    }

    /* Default text color per mode */
    code[class*="language-"] {
        color: #24292e;
    }
    html.dark code[class*="language-"] {
        color: #e1e4e8;
    }

    /* Blinking cursor on last line */
    @keyframes blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    pre[class*="language-"]::after {
        content: "█";
        color: #f43f5e;
        animation: blink 1s step-start infinite;
    }
</style>
