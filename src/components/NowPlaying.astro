---
// Live Spotify card — data comes from /api/now-playing/ (src/pages/api/now-playing.ts)
---

<!-- Spotify now playing card -->
<div
    id="now-playing"
    class="w-full rounded-lg border border-gray-200 dark:border-gray-600 overflow-hidden text-left"
>
    <!-- Card header -->
    <div
        class="flex items-center gap-2 px-3 py-2 bg-gray-100 dark:bg-gray-900/60 border-b border-gray-200 dark:border-gray-600"
    >
        <!-- Spotify logo -->
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-gray-600 dark:text-gray-300 shrink-0"
        >
            <path
                d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"
            ></path>
        </svg>
        <span id="np-label" class="text-xs font-medium text-gray-600 dark:text-gray-300">
            now_playing
        </span>
        <span
            id="np-live"
            class="hidden ml-auto px-1.5 py-px rounded border border-primary text-primary text-[10px] font-bold leading-none tracking-wider"
        >
            LIVE
        </span>
        <span id="np-ago" class="hidden ml-auto text-[10px] text-gray-400 dark:text-gray-500"></span>
    </div>

    <!-- Body: skeleton until loaded -->
    <div class="flex items-center gap-3 p-3">
        <div class="relative w-12 h-12 shrink-0">
            <span id="np-art-skeleton" class="absolute inset-0 rounded bg-gray-200 dark:bg-gray-700 animate-pulse"></span>
            <img
                id="np-art"
                alt=""
                width="48"
                height="48"
                loading="lazy"
                class="hidden absolute inset-0 w-12 h-12 rounded object-cover"
            />
        </div>

        <div class="flex flex-col gap-1 min-w-0 flex-1">
            <a
                id="np-title"
                target="_blank"
                rel="noopener noreferrer"
                class="h-4 w-32 rounded bg-gray-200 dark:bg-gray-700 animate-pulse text-sm font-bold text-gray-800 dark:text-gray-100 truncate hover:text-primary dark:hover:text-primary transition-colors duration-150"
            ></a>
            <span
                id="np-artist"
                class="h-3 w-20 rounded bg-gray-200 dark:bg-gray-700 animate-pulse text-xs text-gray-500 dark:text-gray-400 truncate"
            ></span>

            <!-- Progress (only while playing) -->
            <div id="np-progress" class="hidden items-center gap-2 mt-1">
                <span id="np-elapsed" class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500">0:00</span>
                <div class="flex-1 h-1 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
                    <div id="np-bar" class="h-full bg-primary rounded-full" style="width:0%"></div>
                </div>
                <span id="np-duration" class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500">0:00</span>
            </div>
        </div>
    </div>
</div>

<script>
    interface NowPlaying {
        isPlaying: boolean;
        title: string;
        artist: string;
        album: string;
        albumArt: string | null;
        url: string;
        progressMs: number;
        durationMs: number;
        playedAt: string | null;
    }

    const POLL_MS = 30_000;
    const SKELETON = ["h-4", "h-3", "w-32", "w-20", "rounded", "bg-gray-200", "dark:bg-gray-700", "animate-pulse"];

    const card = document.getElementById("now-playing");
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const label = $("np-label");
    const live = $("np-live");
    const ago = $("np-ago");
    const artSkeleton = $("np-art-skeleton");
    const art = $<HTMLImageElement>("np-art");
    const title = $<HTMLAnchorElement>("np-title");
    const artist = $("np-artist");
    const progress = $("np-progress");
    const elapsed = $("np-elapsed");
    const bar = $("np-bar");
    const duration = $("np-duration");

    let current: NowPlaying | null = null;
    let progressBase = 0; // progressMs at time of last fetch
    let fetchedAt = 0;
    let pollTimer: ReturnType<typeof setInterval> | undefined;
    let tickTimer: ReturnType<typeof setInterval> | undefined;

    const fmt = (ms: number) => {
        const s = Math.floor(ms / 1000);
        return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    };

    const timeAgo = (iso: string) => {
        const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60_000);
        if (mins < 1) return "just now";
        if (mins < 60) return `${mins}m ago`;
        const hours = Math.round(mins / 60);
        if (hours < 24) return `${hours}h ago`;
        return `${Math.round(hours / 24)}d ago`;
    };

    function tick() {
        if (!current?.isPlaying) return;
        const pos = Math.min(progressBase + (Date.now() - fetchedAt), current.durationMs);
        elapsed.textContent = fmt(pos);
        bar.style.width = `${(pos / current.durationMs) * 100}%`;
        // Track likely ended — stop ticking and grab the next one
        if (pos >= current.durationMs) {
            clearInterval(tickTimer);
            load();
        }
    }

    function render(data: NowPlaying) {
        current = data;
        progressBase = data.progressMs;
        fetchedAt = Date.now();

        title.classList.remove(...SKELETON);
        artist.classList.remove(...SKELETON);
        title.textContent = data.title;
        title.href = data.url;
        title.title = `${data.title} — ${data.album}`;
        artist.textContent = data.artist;

        if (data.albumArt) {
            art.src = data.albumArt;
            art.alt = `${data.album} cover`;
            art.classList.remove("hidden");
            artSkeleton.classList.add("hidden");
        }

        label.textContent = data.isPlaying ? "now_playing" : "last_played";
        live.classList.toggle("hidden", !data.isPlaying);
        ago.classList.toggle("hidden", data.isPlaying || !data.playedAt);
        if (data.playedAt) ago.textContent = timeAgo(data.playedAt);

        progress.classList.toggle("hidden", !data.isPlaying);
        progress.classList.toggle("flex", data.isPlaying);
        duration.textContent = fmt(data.durationMs);

        clearInterval(tickTimer);
        if (data.isPlaying) {
            tick();
            tickTimer = setInterval(tick, 1000);
        }
    }

    async function load() {
        try {
            const res = await fetch("/api/now-playing/");
            if (!res.ok) throw new Error();
            render(await res.json());
        } catch {
            // Nothing to show yet — drop the card rather than leave a skeleton
            if (!current) {
                stop();
                card?.remove();
            }
        }
    }

    function start() {
        load();
        pollTimer = setInterval(load, POLL_MS);
    }

    function stop() {
        clearInterval(pollTimer);
        clearInterval(tickTimer);
    }

    // Don't poll Spotify from background tabs
    document.addEventListener("visibilitychange", () => {
        if (!card?.isConnected) return;
        document.hidden ? stop() : start();
    });

    start();
</script>
