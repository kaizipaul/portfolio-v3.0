---
interface Props {
    contentId: string;
    contentName: string;
};

const {
    contentId,
    contentName,
} = Astro.props as Props;

const ext = contentName.split('.').pop() ?? '';

const iconMap: Record<string, string> = {
    ts:   'file-code-2',
    md:   'file-text',
    json: 'file-json',
};

const iconName = iconMap[ext] ?? 'file';
---

<label
    for={contentId}
    class={[
        "tab-link",

        "flex items-center gap-2 py-2 px-3 sm:px-4 text-xs cursor-pointer shrink-0",

        "text-gray-600 dark:text-gray-100",
        "hover:text-primary",

        "!border-r",
        "!border-r-gray-200 dark:!border-r-gray-600"
    ].join(" ")}
>
    <i data-lucide={iconName} class="w-4 h-4 shrink-0"></i>
    <h2>{contentName}</h2>
</label>

<script>
    import { createIcons, FileCode2, FileText, FileJson, File } from 'lucide';
    createIcons({ icons: { FileCode2, FileText, FileJson, File } });
</script>
